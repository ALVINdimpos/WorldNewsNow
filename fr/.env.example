# API origin for Vite dev proxy target (vite.config.js) and for production builds.
# While running `npm run dev`, the app calls `/api` on the same origin; Vite proxies to this URL.
VITE_API_URL=http://localhost:5001
VITE_SITE_URL=https://www.primeworld.news

# Optional: AdSense display ad slot ID from your AdSense dashboard.
# Without this, auto-format ads use your publisher client ID only.
# VITE_ADSENSE_SLOT=1234567890
